{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReasoningResponse",
  "description": "Returned by Person 2's POST /reason (request: {graph: GraphData, fieldConfidence: FieldConfidence | null, chartAspect: number | null}, where chartAspect is the drawn plot's height / width, default 0.6). Everything the frontend needs in one call, so exploration and preset questions work with no further network requests. Call /reason again after any user correction.",
  "type": "object",
  "required": [
    "overview",
    "answers",
    "series",
    "range",
    "lowConfidence",
    "phrasing"
  ],
  "$defs": {
    "answer": {
      "type": "object",
      "required": [
        "answer",
        "highlight",
        "caveats"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "description": "Ready-to-speak text."
        },
        "highlight": {
          "type": "array",
          "description": "Points the answer refers to, for focusing or highlighting in the UI.",
          "items": {
            "type": "object",
            "required": [
              "series",
              "index"
            ],
            "properties": {
              "series": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "description": "Index into xAxis.values."
              }
            }
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Uncertainty to announce, e.g. unreadable values or low confidence."
        }
      }
    }
  },
  "properties": {
    "overview": {
      "type": "object",
      "required": [
        "text",
        "caveats"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Spoken by the Overview button: graph type and axes (with the value range). The shape is left for the ring to reveal. GraphData.summary is ignored."
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "required": [
        "trend",
        "max",
        "changes",
        "compare"
      ],
      "properties": {
        "trend": {
          "$ref": "#/$defs/answer"
        },
        "max": {
          "$ref": "#/$defs/answer"
        },
        "changes": {
          "$ref": "#/$defs/answer"
        },
        "compare": {
          "$ref": "#/$defs/answer",
          "description": "With one series, answers that there is nothing to compare."
        }
      }
    },
    "series": {
      "type": "array",
      "description": "One entry per series; each is explored independently.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "intro",
          "points",
          "trace",
          "interestPoints"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "intro": {
            "type": "string",
            "description": "Spoken when the user switches to this series."
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "x",
                "value",
                "normalised",
                "delta",
                "changeStrength",
                "direction",
                "isMax",
                "isMin",
                "isTurningPoint",
                "lowConfidence",
                "readout"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "x": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "null = could not be read."
                },
                "normalised": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "(value - min) / (max - min) over ALL series, so series share one pitch scale. 0.5 if every value is equal."
                },
                "delta": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Change from the previous point; null for the first point or when either value is missing."
                },
                "changeStrength": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "|delta| / (max - min), capped at 1. 0 for the first point; null when either value is missing."
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "flat",
                    "unknown"
                  ],
                  "description": "Versus the previous point; moves under 2% of the value range are flat. 'flat' for the first point; 'unknown' when this or the previous value is missing."
                },
                "isMax": {
                  "type": "boolean",
                  "description": "Highest point of this series."
                },
                "isMin": {
                  "type": "boolean",
                  "description": "Lowest point of this series."
                },
                "isTurningPoint": {
                  "type": "boolean",
                  "description": "The trend reverses here (peak or trough)."
                },
                "lowConfidence": {
                  "type": "boolean"
                },
                "readout": {
                  "type": "string",
                  "description": "Ready-to-speak, e.g. 'March, 12 degrees Celsius, up 5 from February.'"
                }
              }
            }
          },
          "trace": {
            "type": "array",
            "description": "The line as segments, for the ring. startFraction/endFraction are x positions on the plot (0 = left edge, 1 = right edge); they also work as time fractions for a timed sweep.",
            "items": {
              "type": "object",
              "required": [
                "fromIndex",
                "toIndex",
                "startFraction",
                "endFraction",
                "angle",
                "strength",
                "direction",
                "endsAtTurningPoint"
              ],
              "properties": {
                "fromIndex": {
                  "type": "integer"
                },
                "toIndex": {
                  "type": "integer"
                },
                "startFraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "endFraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "angle": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -90,
                  "maximum": 90,
                  "description": "Slope as drawn (on a plot chartAspect times as tall as wide): 0 = flat (point the ring right), +90 = straight up, -90 = straight down. null over an unreadable gap."
                },
                "strength": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "|change| / value range; null over a gap."
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "flat",
                    "unknown"
                  ]
                },
                "endsAtTurningPoint": {
                  "type": "boolean"
                }
              }
            }
          },
          "interestPoints": {
            "type": "array",
            "description": "Stops for the Explore page's 'Next point' button, left to right: start, peaks, lows, max, min, end.",
            "items": {
              "type": "object",
              "required": [
                "index",
                "x",
                "value",
                "xFraction",
                "normalised",
                "kinds",
                "explain"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "x": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "xFraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Where to guide the finger horizontally."
                },
                "normalised": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Where to guide the finger vertically (0 = bottom of the value range)."
                },
                "kinds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "start",
                      "end",
                      "max",
                      "min",
                      "peak",
                      "low"
                    ]
                  }
                },
                "explain": {
                  "type": "string",
                  "description": "Spoken by the Explain button: coordinates, then why the point matters. Shorter than the overview."
                }
              }
            }
          }
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "lowConfidence": {
      "type": "boolean",
      "description": "graph.confidence or fieldConfidence.series below 0.6; numbers are then spoken as 'about ...'."
    },
    "phrasing": {
      "type": "string",
      "enum": [
        "template",
        "llm"
      ],
      "description": "Whether texts were reworded by Gemini (USE_LLM=1) or are the deterministic templates."
    }
  }
}
